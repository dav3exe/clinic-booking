# MongoDB Atlas connection string (database name in the path, e.g. /clinic)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clinic?retryWrites=true&w=majority
# Optional, local only: set if you get "querySrv ECONNREFUSED" (leave unset on Vercel)
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# The key checkers send in the X-API-Key header
API_KEY=change-me-to-a-long-random-string
